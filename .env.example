# Copy this file to `.env` and fill in real values before running in production.
# Never commit the real .env file to git.

# A long random string used to sign login sessions. Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-long-random-string

# How many hours someone stays logged in before ID+Password+OTP is required again.
# This directly answers Question 10 from the blueprint.
ACCESS_TOKEN_EXPIRE_HOURS=24

# OTP code length -- 4 or 6, per the blueprint (Module 10).
OTP_LENGTH=4

# The very first login account, created automatically the first time the
# server starts against an empty database. Change these before going live --
# after first login you can add real users directly in the database (or we
# can add a proper "manage users" screen later if the client needs more than
# one login).
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin123
SEED_ADMIN_MOBILE=9800000000   # where this login receives its OTP; change it here and restart to move it to another number

# --- How the login code is delivered: OTP_PROVIDER = dev | email | fast2sms ---
#   dev (or not set)  the code is only printed in the server log (testing / no provider yet)
#   email             the code is emailed through Resend (free for this volume)
#   fast2sms          the code is sent on WhatsApp through Fast2SMS
# A wrong value is refused (login shows an error) rather than quietly printing codes in the log.

# --- Email code via Resend (OTP_PROVIDER=email) ---
# OTP_PROVIDER=email
# RESEND_API_KEY=        (resend.com -> API Keys. Keep it secret: set it only on the server, never in git.)
# OTP_EMAIL_FROM=Shivkrupa Enterprises <login@your-verified-domain.in>
#                        (needs a domain verified in Resend. Without it, Resend's test sender is used,
#                         which can only email the address the Resend account was created with.)
# SEED_ADMIN_EMAIL=owner@example.com   (the address that receives the login's code; change it and restart to move it)
# OTP_LENGTH=6

# --- Real OTP on WhatsApp via Fast2SMS (OTP_PROVIDER=fast2sms; needs Meta to have approved the
#     WhatsApp number's display name) ---
# OTP_PROVIDER=fast2sms
# FAST2SMS_API_KEY=      (Fast2SMS dashboard -> API Key. Keep it secret: set it only on the server, never in git.)
# FAST2SMS_OTP_ID=       (Fast2SMS dashboard -> Smart OTP -> the template whose first channel is WhatsApp)
# OTP_LENGTH=6           (set to the number of digits in the code Fast2SMS sends; between 4 and 6)
