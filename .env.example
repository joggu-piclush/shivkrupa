# Copy this file to `.env` and fill in real values before running in production.
# Never commit the real .env file to git.

# A long random string used to sign login sessions. Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-long-random-string

# How many hours someone stays logged in before ID+Password+OTP is required again.
# This directly answers Question 10 from the blueprint.
ACCESS_TOKEN_EXPIRE_HOURS=24

# OTP code length -- 4 or 6, per the blueprint (Module 10).
OTP_LENGTH=4

# The very first login account, created automatically the first time the
# server starts against an empty database. Change these before going live --
# after first login you can add real users directly in the database (or we
# can add a proper "manage users" screen later if the client needs more than
# one login).
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin123
SEED_ADMIN_MOBILE=9800000000   # where this login receives its OTP; change it here and restart to move it to another number

# --- Real OTP on WhatsApp via Fast2SMS (leave OTP_PROVIDER out to stay in dev mode,
#     where the code is only printed in the server log) ---
# OTP_PROVIDER=fast2sms
# FAST2SMS_API_KEY=      (Fast2SMS dashboard -> API Key. Keep it secret: set it only on the server, never in git.)
# FAST2SMS_OTP_ID=       (Fast2SMS dashboard -> Smart OTP -> the template whose first channel is WhatsApp)
# OTP_LENGTH=6           (set to the number of digits in the code Fast2SMS sends; between 4 and 6)
